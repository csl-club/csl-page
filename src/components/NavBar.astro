---
import { url } from "../lib/url";
const links = [
    {
        name: "Eventos",
        href: url("/events")
    },
    {
        name: "Proyectos",
        href: url("/projects")
    },
    {
        name:"Galería",
        href: url("/gallery")
    },
    {
        name: "Comunidad",
        href: "https://chat.whatsapp.com/GqyY8jvM8Q45zYPZXpnfwm"
    }
    //this should be modified according to the pages that are created in the project.
]
---


<nav class="header__nav">
  {links.map(link => {
    if (link.name === "Comunidad"){
        return (<a href={link.href} class="header__nav__link-alt" target="blank">
      {link.name}
        </a>)
    }

    return (<a href={link.href} class="header__nav__link">
      {link.name}
    </a>)
  })}
</nav>
